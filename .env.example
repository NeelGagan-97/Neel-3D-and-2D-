# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Public Browser Configuration (build-time Vite variables; safe for browser)
# NEVER put your Supabase service_role or secret key in any VITE_* variable.
# Required: Supabase Project URL (e.g. https://<project-ref>.supabase.co)
VITE_SUPABASE_URL=
# Required: Set ONE of the following public client keys from Supabase Settings -> API:
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: Deployed app origin for Auth email redirects (defaults to window.location.origin)
VITE_APP_URL=

# Optional Server-Side Licensed CAD DWG Conversion Engines (never set in VITE_*)
# Native AutoCAD DWG export is only enabled when a real installed converter binary is configured.
# Blue Space NEVER renames DXF files as DWG.
ODA_FILE_CONVERTER_PATH=
LIBREDWG_DXF2DWG_PATH=

# Server-Side Only Supabase Admin Configuration (NEVER prefix with VITE_* or expose in browser)
# Used by server.ts to persist the central electrical product catalogue in Supabase DB
# and upload verified product images permanently into Supabase Storage (bucket: catalogue-images).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

